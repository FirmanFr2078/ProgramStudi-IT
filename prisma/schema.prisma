generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH & PENGGUNA (Supabase Auth)
// ============================================================

enum Role {
  admin
  // role baru (mis. "editor") tambahkan di sini + izinnya di src/lib/permissions.ts
}

model tbl_profiles {
  // Di-generate Prisma sendiri (uuid v4) — BUKAN lagi auth.users.id Supabase,
  // karena kita ga pakai Supabase Auth. Komentar trigger lama sudah ga relevan.
  id_profile String @id @default(uuid()) @db.Uuid
  username   String @unique @db.VarChar(50) // selalu huruf kecil, dipaksa di client & server
  password   String @db.VarChar(255) // bcryptjs hash, 12 rounds
  email      String @unique @db.VarChar(150)

  nama String  @db.VarChar(100)
  foto String? @db.VarChar(255) // path bucket "images", folder "profil/"

  role Role @default(admin)

  is_active       Boolean   @default(true)
  session_version Int       @default(1) // naik tiap logout/ganti password -> revoke semua token lama
  last_login_at   DateTime? @db.Timestamptz(6)

  activity_logs     tbl_activity_log[]
  mitra_created     tbl_mitra[]                 @relation("MitraCreatedBy")
  mitra_updated     tbl_mitra[]                 @relation("MitraUpdatedBy")
  kode_dibuat       tbl_kerja_sama_kode_unduh[] @relation("KodeDibuatOleh")
  kode_dicabut      tbl_kerja_sama_kode_unduh[] @relation("KodeDicabutOleh")
  naskah_created    tbl_kerja_sama[]            @relation("NaskahCreatedBy")
  naskah_updated    tbl_kerja_sama[]            @relation("NaskahUpdatedBy")
  kegiatan_created  tbl_kerja_sama_kegiatan[]   @relation("KegiatanCreatedBy")
  kegiatan_updated  tbl_kerja_sama_kegiatan[]   @relation("KegiatanUpdatedBy")
  kabar_created     tbl_kabar[]                 @relation("KabarCreatedBy")
  kabar_updated     tbl_kabar[]                 @relation("KabarUpdatedBy")
  dosen_created     tbl_dosen[]                 @relation("DosenCreatedBy")
  dosen_updated     tbl_dosen[]                 @relation("DosenUpdatedBy")
  fasilitas_created tbl_fasilitas[]             @relation("FasilitasCreatedBy")
  fasilitas_updated tbl_fasilitas[]             @relation("FasilitasUpdatedBy")

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

enum ActivityAction {
  create
  update
  delete
  login
  login_failed
  logout
  error
  forbidden
}

model tbl_activity_log {
  id_log BigInt @id @default(autoincrement())

  actor_id       String?       @db.Uuid
  actor          tbl_profiles? @relation(fields: [actor_id], references: [id_profile], onDelete: SetNull)
  actor_nama     String?       @db.VarChar(100) // snapshot -- tetap kebaca walau akun dihapus
  actor_username String?       @db.VarChar(50)

  action    ActivityAction
  entity    String?        @db.VarChar(50) // nama tabel/konteks terkait, null utk login/logout/error umum
  entity_id String?        @db.VarChar(50) // String krn tipe PK beda2 (BigInt vs Uuid)

  deskripsi String @db.VarChar(255)

  data_lama Json? // snapshot sebelum perubahan
  data_baru Json? // snapshot sesudah, atau detail error (message+stack)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity, entity_id])
  @@index([actor_id])
}

// ============================================================
// KONTEN (Berita/Pengumuman & Event)
// ============================================================

enum KategoriKabar {
  Berita
  Pengumuman
}

model tbl_kabar {
  id_kabar BigInt @id @default(autoincrement())

  // Dipakai di URL /informasi/kabar/[slug]. Dibuat dari judul, boleh diedit manual.
  slug      String        @unique @db.VarChar(150)
  judul     String        @db.VarChar(200)
  ringkasan String        @db.VarChar(300)
  konten    Json          @db.JsonB // artikel terstruktur sebagai array ArticleBlock
  kategori  KategoriKabar
  tanggal   DateTime      @db.Date
  gambar    String?       @db.VarChar(255) // path bucket "images"

  created_by_id String?       @db.Uuid
  created_by    tbl_profiles? @relation("KabarCreatedBy", fields: [created_by_id], references: [id_profile], onDelete: SetNull)

  updated_by_id String?       @db.Uuid
  updated_by    tbl_profiles? @relation("KabarUpdatedBy", fields: [updated_by_id], references: [id_profile], onDelete: SetNull)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

enum KategoriEvent {
  Seminar
  Workshop
  Lomba
  KuliahUmum @map("Kuliah Umum")
  Lainnya
}

model tbl_event {
  id_event BigInt @id @default(autoincrement())

  slug            String        @unique @db.VarChar(150)
  judul           String        @db.VarChar(200)
  ringkasan       String        @db.VarChar(300)
  konten          String[]
  kategori        KategoriEvent
  tanggal_mulai   DateTime      @db.Date
  tanggal_selesai DateTime?     @db.Date // kosong = acara cuma 1 hari
  waktu           String?       @db.VarChar(50) // mis. "09:00 - 12:00 WIB"
  lokasi          String        @db.VarChar(200)
  tautan_daftar   String?       @db.VarChar(255)
  gambar          String?       @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

// ============================================================
// SDM (Dosen & Tendik)
// ============================================================

enum JabatanFungsional {
  TenagaPengajar @map("Tenaga Pengajar")
  AsistenAhli    @map("Asisten Ahli")
  Lektor
  LektorKepala   @map("Lektor Kepala")
  GuruBesar      @map("Guru Besar")
}

model tbl_dosen {
  id_dosen BigInt @id @default(autoincrement())

  slug String @unique @db.VarChar(150)
  nama String @db.VarChar(150) // termasuk gelar, mis. "Dr. Ahmad Fauzi, M.Kom."
  nidn String @unique @db.VarChar(20)

  jabatan_struktural String?           @db.VarChar(100) // kosong = dosen biasa, bukan error
  jabatan_fungsional JabatanFungsional

  // Riwayat pendidikan diratain jadi kolom langsung, BUKAN tabel terpisah --
  // tiap dosen pasti maks 1 baris per jenjang (S1/S2/S3), jadi child table
  // di sini cuma nambah JOIN tanpa manfaat nyata. S1 wajib, S2/S3 opsional.
  pendidikan_s1_bidang String  @db.VarChar(100)
  pendidikan_s1_kampus String  @db.VarChar(150)
  pendidikan_s2_bidang String? @db.VarChar(100)
  pendidikan_s2_kampus String? @db.VarChar(150)
  pendidikan_s3_bidang String? @db.VarChar(100)
  pendidikan_s3_kampus String? @db.VarChar(150)

  bidang_keahlian String[]
  mata_kuliah     String[] // nama mata kuliah yg diampu, bukan FK -- lihat catatan di atas
  struktur_posisi tbl_struktur_posisi[]

  email          String  @unique @db.VarChar(150)
  foto           String? @db.VarChar(255)
  sinta          String? @db.VarChar(255)
  google_scholar String? @db.VarChar(255)

  created_by_id String?       @db.Uuid
  created_by    tbl_profiles? @relation("DosenCreatedBy", fields: [created_by_id], references: [id_profile], onDelete: SetNull)

  updated_by_id String?       @db.Uuid
  updated_by    tbl_profiles? @relation("DosenUpdatedBy", fields: [updated_by_id], references: [id_profile], onDelete: SetNull)

  kerja_sama tbl_kerja_sama[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

enum UnitKerja {
  TataUsaha       @map("Tata Usaha")
  LayananAkademik @map("Layanan Akademik")
  Laboratorium
  Perpustakaan
  KeuanganUmum    @map("Keuangan & Umum")
}

model tbl_tendik {
  id_tendik BigInt @id @default(autoincrement())

  slug        String    @unique @db.VarChar(150)
  nama        String    @db.VarChar(150)
  jabatan     String    @db.VarChar(100) // mis. "Staf Administrasi Akademik"
  unit_kerja  UnitKerja
  tugas       String[]
  lokasi      String    @db.VarChar(150) // mis. "Ruang Tata Usaha, Gedung A lt.1"
  jam_layanan String    @db.VarChar(50)
  pendidikan  String    @db.VarChar(150) // pendidikan terakhir, teks bebas
  email       String    @unique @db.VarChar(150)
  telepon     String?   @db.VarChar(20)
  foto        String?   @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

// ============================================================
// MAHASISWA (Alumni & Prestasi)
// ============================================================

enum StatusKarier {
  Bekerja
  Wirausaha
  MelanjutkanStudi @map("Melanjutkan Studi")
  MencariKerja     @map("Mencari Kerja")
}

model tbl_alumni {
  id_alumni     BigInt       @id @default(autoincrement())
  nama          String       @db.VarChar(150)
  nim           String       @unique @db.VarChar(30)
  tahun_lulus   Int
  status_karier StatusKarier
  pekerjaan     String?      @db.VarChar(200) // posisi + instansi, satu baris teks
}

enum TingkatPrestasi {
  Internasional
  Nasional
  Provinsi
  Kampus
}

model tbl_prestasi {
  id_prestasi   BigInt          @id @default(autoincrement())
  judul         String          @db.VarChar(200) // nama lomba/kompetisi/hibah
  penyelenggara String          @db.VarChar(200)
  tingkat       TingkatPrestasi

  // Bisa tim, lebih dari satu nama. Array cukup -- belum ada fitur yang
  // butuh "cari semua prestasi yang pernah diikuti mahasiswa X".
  mahasiswa String[]

  peringkat  String  @db.VarChar(50) // "Juara 1", "Pendanaan Nasional", dst -- teks bebas
  tahun      Int
  pembimbing String? @db.VarChar(150)
}

// ============================================================
// KERJA SAMA (Mitra)
// ============================================================

enum TingkatKerjaSama {
  Internasional
  Nasional
  LokalWilayah  @map("Lokal/Wilayah")
}

enum BidangKerjaSama {
  Pendidikan
  Penelitian
  PengabdianMasyarakat    @map("Pengabdian Masyarakat")
  PengembanganKelembagaan @map("Pengembangan Kelembagaan")
}

enum JenisNaskah {
  LoI
  MoU
  PKS // = MoA
  IA
  Addendum
}

enum StatusNaskah {
  Draft
  Berlaku // masa berlaku dihitung dari tanggal, bukan disimpan
  Dibatalkan
}

enum StatusKegiatan {
  Direncanakan
  Berjalan
  Selesai
  Dibatalkan
}

enum JenisBerkas {
  Naskah
  Addendum
  SuratTugas  @map("Surat Tugas")
  Laporan
  Dokumentasi
  Sertifikat
  Luaran
  Lainnya
}

// ---------- REFERENSI (diedit admin) ----------
model tbl_ref_kategori_mitra {
  id_kategori BigInt      @id @default(autoincrement())
  nama        String      @unique @db.VarChar(100)
  urutan      Int         @default(0)
  aktif       Boolean     @default(true)
  mitra       tbl_mitra[]
}

model tbl_ref_bentuk {
  id_bentuk BigInt                    @id @default(autoincrement())
  nama      String                    @unique @db.VarChar(100)
  bidang    BidangKerjaSama
  urutan    Int                       @default(0)
  aktif     Boolean                   @default(true)
  naskah    tbl_kerja_sama[]
  kegiatan  tbl_kerja_sama_kegiatan[]
}

// ---------- MITRA (identitas lembaga) ----------
model tbl_mitra {
  id_mitra     BigInt                 @id @default(autoincrement())
  slug         String                 @unique @db.VarChar(150)
  nama         String                 @db.VarChar(200)
  nama_singkat String?                @db.VarChar(30) // dipakai untuk inisial logo
  kategori_id  BigInt
  kategori     tbl_ref_kategori_mitra @relation(fields: [kategori_id], references: [id_kategori], onDelete: Restrict)
  tingkat      TingkatKerjaSama
  negara       String                 @default("Indonesia") @db.VarChar(80)
  kota         String?                @db.VarChar(100)
  website      String?                @db.VarChar(255)
  logo         String?                @db.VarChar(255) // path bucket images, folder mitra/

  ringkasan String   @db.VarChar(300)
  deskripsi String[]

  tampil_publik  Boolean @default(false) // draft sampai admin menyalakan
  unggulan       Boolean @default(false)
  tampil_di_mbkm Boolean @default(false)
  urutan         Int     @default(0)

  // kontak: internal secara default
  kontak_nama      String? @db.VarChar(150)
  kontak_jabatan   String? @db.VarChar(100)
  kontak_email     String? @db.VarChar(150)
  kontak_telepon   String? @db.VarChar(20)
  kontak_publik    Boolean @default(false)
  catatan_internal String?

  naskah tbl_kerja_sama[]

  created_by_id String?       @db.Uuid
  created_by    tbl_profiles? @relation("MitraCreatedBy", fields: [created_by_id], references: [id_profile], onDelete: SetNull)
  updated_by_id String?       @db.Uuid
  updated_by    tbl_profiles? @relation("MitraUpdatedBy", fields: [updated_by_id], references: [id_profile], onDelete: SetNull)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  @@index([kategori_id])
}

// ---------- NASKAH (LoI / MoU / PKS / IA) ----------
model tbl_kerja_sama {
  id_kerja_sama BigInt    @id @default(autoincrement())
  mitra_id      BigInt
  mitra         tbl_mitra @relation(fields: [mitra_id], references: [id_mitra], onDelete: Restrict)

  jenis  JenisNaskah
  judul  String       @db.VarChar(250)
  status StatusNaskah @default(Draft)

  nomor_prodi String?   @unique @db.VarChar(100)
  nomor_mitra String?   @db.VarChar(100)
  tempat_ttd  String?   @db.VarChar(100)
  tanggal_ttd DateTime? @db.Date
  mulai       DateTime  @db.Date
  berakhir    DateTime? @db.Date // kosong = tanpa batas waktu

  ruang_lingkup String?
  pembiayaan    String? @db.VarChar(255)

  ttd_prodi   String?    @db.VarChar(200) // nama + jabatan penandatangan
  ttd_mitra   String?    @db.VarChar(200)
  pj_dosen_id BigInt?
  pj_dosen    tbl_dosen? @relation(fields: [pj_dosen_id], references: [id_dosen], onDelete: SetNull)
  pj_mitra    String?    @db.VarChar(150)

  induk_id             BigInt?
  induk                tbl_kerja_sama?  @relation("NaskahInduk", fields: [induk_id], references: [id_kerja_sama], onDelete: SetNull)
  turunan              tbl_kerja_sama[] @relation("NaskahInduk")
  perpanjangan_dari_id BigInt?
  perpanjangan_dari    tbl_kerja_sama?  @relation("NaskahPerpanjangan", fields: [perpanjangan_dari_id], references: [id_kerja_sama], onDelete: SetNull)
  perpanjangan_berikut tbl_kerja_sama[] @relation("NaskahPerpanjangan")

  bentuk           tbl_ref_bentuk[]
  kegiatan         tbl_kerja_sama_kegiatan[]
  berkas           tbl_kerja_sama_berkas[]
  catatan_internal String?

  preview    String?                     @db.VarChar(255) // path bucket "images", folder naskah-preview/
  kode_unduh tbl_kerja_sama_kode_unduh[]

  created_by_id String?       @db.Uuid
  created_by    tbl_profiles? @relation("NaskahCreatedBy", fields: [created_by_id], references: [id_profile], onDelete: SetNull)
  updated_by_id String?       @db.Uuid
  updated_by    tbl_profiles? @relation("NaskahUpdatedBy", fields: [updated_by_id], references: [id_profile], onDelete: SetNull)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  @@index([mitra_id])
  @@index([berakhir])
  @@index([induk_id])
}

// ---------- KEGIATAN (realisasi; baris di Tabel 1 IAPS) ----------
model tbl_kerja_sama_kegiatan {
  id_kegiatan   BigInt         @id @default(autoincrement())
  kerja_sama_id BigInt
  kerja_sama    tbl_kerja_sama @relation(fields: [kerja_sama_id], references: [id_kerja_sama], onDelete: Cascade)

  bidang    BidangKerjaSama
  bentuk_id BigInt?
  bentuk    tbl_ref_bentuk? @relation(fields: [bentuk_id], references: [id_bentuk], onDelete: SetNull)

  judul           String         @db.VarChar(250)
  uraian          String?
  manfaat         String[] // manfaat bagi program studi
  tanggal_mulai   DateTime       @db.Date
  tanggal_selesai DateTime?      @db.Date
  jumlah_peserta  Int?
  status          StatusKegiatan @default(Direncanakan)
  tampil_publik   Boolean        @default(false)

  berkas tbl_kerja_sama_berkas[]

  created_by_id String?       @db.Uuid
  created_by    tbl_profiles? @relation("KegiatanCreatedBy", fields: [created_by_id], references: [id_profile], onDelete: SetNull)
  updated_by_id String?       @db.Uuid
  updated_by    tbl_profiles? @relation("KegiatanUpdatedBy", fields: [updated_by_id], references: [id_profile], onDelete: SetNull)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @updatedAt @db.Timestamptz(6)

  @@index([kerja_sama_id])
  @@index([tanggal_mulai])
}

// ---------- BERKAS (naskah ATAU kegiatan) ----------
// Tambahkan CHECK lewat SQL di migration: tepat salah satu dari kerja_sama_id / kegiatan_id terisi.
model tbl_kerja_sama_berkas {
  id_berkas     BigInt                   @id @default(autoincrement())
  kerja_sama_id BigInt?
  kerja_sama    tbl_kerja_sama?          @relation(fields: [kerja_sama_id], references: [id_kerja_sama], onDelete: Cascade)
  kegiatan_id   BigInt?
  kegiatan      tbl_kerja_sama_kegiatan? @relation(fields: [kegiatan_id], references: [id_kegiatan], onDelete: Cascade)

  jenis      JenisBerkas
  label      String      @db.VarChar(150)
  path       String?     @db.VarChar(255) // bucket PRIVAT "kerja-sama" (signed URL)
  tautan     String?     @db.VarChar(255) // alternatif: link eksternal (https)
  mime       String?     @db.VarChar(100)
  utama      Boolean     @default(false) // berkas yang diunduh lewat kode di landing
  ukuran     Int?
  created_at DateTime    @default(now()) @db.Timestamptz(6)

  @@index([kerja_sama_id])
  @@index([kegiatan_id])
}

// ---------- KODE UNDUH (sekali pakai, satu per peminta) ----------
// Kode utuh TIDAK disimpan, hanya HMAC-nya. Status dihitung dari tanggal:
//   dicabut_pada terisi                      -> Dicabut
//   dipakai_pertama_pada kosong              -> Aktif (tanpa batas waktu)
//   dipakai_pertama_pada + 10 menit > now    -> Dalam Masa Unduh
//   selebihnya                               -> Habis
model tbl_kerja_sama_kode_unduh {
  id_kode       BigInt         @id @default(autoincrement())
  kerja_sama_id BigInt
  kerja_sama    tbl_kerja_sama @relation(fields: [kerja_sama_id], references: [id_kerja_sama], onDelete: Cascade)

  kode_hash String  @unique @db.VarChar(64)
  petunjuk  String  @db.VarChar(4) // 4 karakter terakhir, hanya penanda di riwayat
  peminta   String  @db.VarChar(150)
  catatan   String? @db.VarChar(300)

  dibuat_oleh_id String?       @db.Uuid
  dibuat_oleh    tbl_profiles? @relation("KodeDibuatOleh", fields: [dibuat_oleh_id], references: [id_profile], onDelete: SetNull)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)

  dipakai_pertama_pada  DateTime? @db.Timestamptz(6)
  terakhir_diunduh_pada DateTime? @db.Timestamptz(6)
  jumlah_unduhan        Int       @default(0)

  dicabut_pada    DateTime?     @db.Timestamptz(6)
  dicabut_oleh_id String?       @db.Uuid
  dicabut_oleh    tbl_profiles? @relation("KodeDicabutOleh", fields: [dicabut_oleh_id], references: [id_profile], onDelete: SetNull)

  @@index([kerja_sama_id])
}

// Pembatas tebak-tebakan kode di endpoint publik. IP disimpan dalam bentuk hash.
model tbl_kerja_sama_kode_gagal {
  id_gagal   BigInt   @id @default(autoincrement())
  ip_hash    String   @db.VarChar(32)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([ip_hash, created_at])
}

// ============================================================
// RISET (Penelitian & Pengabdian satu tabel, beda kolom `jenis`) & HKI
// ============================================================

enum JenisRiset {
  Penelitian
  Pengabdian
}

model tbl_riset {
  id_riset    BigInt     @id @default(autoincrement())
  jenis       JenisRiset
  judul       String     @db.VarChar(250)
  ketua       String     @db.VarChar(150)
  anggota     String[]
  tahun       Int
  sumber_dana String     @db.VarChar(150)
}

enum JenisHki {
  HakCipta       @map("Hak Cipta")
  Paten
  PatenSederhana @map("Paten Sederhana")
  DesainIndustri @map("Desain Industri")
  Merek
}

enum StatusHki {
  Terdaftar
  DalamProses @map("Dalam Proses")
}

model tbl_hki {
  id_hki   BigInt    @id @default(autoincrement())
  judul    String    @db.VarChar(250)
  jenis    JenisHki
  pencipta String[]
  nomor    String    @unique @db.VarChar(100) // nomor pendaftaran/sertifikat
  tahun    Int
  status   StatusHki
}

// ============================================================
// PENDIDIKAN (Jadwal, Kalender, Kurikulum, MBKM)
// ============================================================

enum Hari {
  Senin
  Selasa
  Rabu
  Kamis
  Jumat
}

model tbl_jadwal {
  id_jadwal   BigInt @id @default(autoincrement())
  hari        Hari
  jam_mulai   String @db.VarChar(5) // "07:00"
  jam_selesai String @db.VarChar(5)
  mata_kuliah String @db.VarChar(150) // teks bebas, bukan FK -- lihat catatan di atas
  sks         Int
  kelas       String @db.VarChar(20) // "TI 4A"
  dosen       String @db.VarChar(150) // teks bebas, bukan FK -- lihat catatan di atas
  ruang       String @db.VarChar(50)
}

model tbl_tanggal_penting {
  id_tanggal BigInt    @id @default(autoincrement())
  mulai      DateTime  @db.Date
  selesai    DateTime? @db.Date // kalau berupa rentang
  keterangan String    @db.VarChar(255)
}

enum JenisMataKuliah {
  Wajib
  Pilihan
}

model tbl_mata_kuliah {
  id_mata_kuliah BigInt          @id @default(autoincrement())
  kode           String          @unique @db.VarChar(20)
  nama           String          @db.VarChar(150)
  sks            Int
  jenis          JenisMataKuliah
  semester       Int // 1-8
}

model tbl_bentuk_kegiatan {
  id_kegiatan BigInt @id @default(autoincrement())
  nama        String @db.VarChar(150)
  icon        String @db.VarChar(50) // nama ikon Lucide, di-resolve jadi komponen di client
}

model tbl_langkah_mbkm {
  id_langkah BigInt @id @default(autoincrement())
  judul      String @db.VarChar(150)
  deskripsi  String
  urutan     Int    @default(0)
}

// ======================================================
// SHARED / LINTAS MODUL
// (dipakai lebih dari satu fitur — jangan duplikasi per modul)
// ======================================================

// DOKUMEN UNDUHAN (lintas modul: Kurikulum, Kerja Sama, Kalender, MBKM)
enum ModulDokumen {
  Kurikulum
  KerjaSama
  Kalender
  Mbkm
}

model tbl_dokumen {
  id_dokumen BigInt       @id @default(autoincrement())
  modul      ModulDokumen
  label      String       @db.VarChar(150)
  url        String       @db.VarChar(255) // path bucket "documents"
  aktif      Boolean      @default(true)
}

//  PENGATURAN HALAMAN LANDING
model tbl_pengaturan_halaman {
  id_pengaturan Int      @id @default(autoincrement())
  kunci         String   @unique @db.VarChar(100) // "profil/kerja-sama", "pendidikan/mbkm", ...
  eyebrow       String?  @db.VarChar(50)
  judul         String   @db.VarChar(150)
  deskripsi     String?  @db.VarChar(400)
  pembuka       String[] // paragraf pengantar
  opsi          Json     @default("{}") // mis. {"tampilkanStatistik": true}
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
}

// ============================================================
// PROFIL PRODI (singleton -- termasuk struktur organisasi)
// ============================================================

model tbl_profil_prodi {
  id_profil Int @id @default(1) // selalu 1 baris -- jangan buat baris kedua

  sambutan_isi String[]

  sejarah String[]
  visi    String
  misi    String[]
  tujuan  String[]

  // {judul, deskripsi}[] -- cuma ditampilkan apa adanya di 1 halaman,
  // ga butuh query/filter per-item, jadi Json lebih hemat dari tabel.
  profil_lulusan Json

  // {label, value}[] -- identitas prodi (akreditasi, SK pendirian, dst).
  identitas Json

  updated_at DateTime @updatedAt @db.Timestamptz(6)
}

// ============================================================
// PENDAFTARAN
// ============================================================

model tbl_jalur_pendaftaran {
  id_jalur  BigInt   @id @default(autoincrement())
  nama      String   @db.VarChar(100)
  deskripsi String
  syarat    String[]
}

// ============================================================
// STRUKTUR ORGANISASI (board bebas posisi — terpisah dari profil prodi)
// ============================================================

enum JalurSambung {
  lurus
  kiri
  kanan
}

model tbl_struktur_posisi {
  id_posisi     BigInt       @id @default(autoincrement())
  is_kaprodi    Boolean      @default(false)
  jalur_sambung JalurSambung @default(lurus)

  parent_id BigInt?
  parent    tbl_struktur_posisi?  @relation("StrukturHierarki", fields: [parent_id], references: [id_posisi], onDelete: Cascade)
  children  tbl_struktur_posisi[] @relation("StrukturHierarki")

  jabatan String  @db.VarChar(100)
  nama    String? @db.VarChar(150)

  dosen_id BigInt?
  dosen    tbl_dosen? @relation(fields: [dosen_id], references: [id_dosen], onDelete: SetNull)

  level        Int @default(1) // baris bawahan di bawah atasannya (1, 2, 3, ...)
  jarak_kosong Int @default(0) // BARU — jumlah baris kosong yang di-skip sebelum baris ini (khusus mode "tembus")

  urutan Int @default(0)

  tupoksi tbl_struktur_tupoksi[]

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([parent_id])
  @@index([dosen_id])
}

model tbl_struktur_tupoksi {
  id_tupoksi BigInt @id @default(autoincrement())

  posisi_id BigInt
  posisi    tbl_struktur_posisi @relation(fields: [posisi_id], references: [id_posisi], onDelete: Cascade)

  isi    String @db.VarChar(300)
  urutan Int    @default(0)

  @@index([posisi_id])
}


// ============================================================
// FASILITAS
// ============================================================

enum KepemilikanAset {
  MilikSendiri @map("Milik Sendiri")
  Sewa
  Pinjam
}

enum KondisiAset {
  Baik
  RusakRingan @map("Rusak Ringan")
  RusakBerat  @map("Rusak Berat")
}

enum StatusFasilitas {
  Aktif
  Renovasi
  TidakDigunakan @map("Tidak Digunakan")
}

enum JenisBerkasFasilitas {
  Foto
  SertifikatKalibrasi @map("Sertifikat Kalibrasi")
  DokumenInventaris   @map("Dokumen Inventaris")
  Lainnya
}

// ---------- REFERENSI KATEGORI (diedit admin; slug dipakai route landing /fasilitas/[slug]) ----------
model tbl_ref_kategori_fasilitas {
  id_kategori BigInt  @id @default(autoincrement())
  slug        String  @unique @db.VarChar(100)
  nama        String  @unique @db.VarChar(100)
  urutan      Int     @default(0)
  aktif       Boolean @default(true)
  fasilitas   tbl_fasilitas[]
}

// ---------- FASILITAS (prasarana: gedung, ruang, area) ----------
model tbl_fasilitas {
  id_fasilitas BigInt @id @default(autoincrement())
  slug         String @unique @db.VarChar(150)
  nama         String @db.VarChar(200)
  kategori_id  BigInt
  kategori     tbl_ref_kategori_fasilitas @relation(fields: [kategori_id], references: [id_kategori], onDelete: Restrict)

  // Hierarki 2 level: gedung (gedung_id = null) -> ruang di dalamnya.
  gedung_id BigInt?
  gedung    tbl_fasilitas?  @relation("FasilitasGedung", fields: [gedung_id], references: [id_fasilitas], onDelete: SetNull)
  ruangan   tbl_fasilitas[] @relation("FasilitasGedung")
  lantai    String? @db.VarChar(20)

  deskripsi String[]
  foto      String? @db.VarChar(255) // path bucket images, folder fasilitas/

  luas_m2     Decimal? @db.Decimal(8, 2)
  kapasitas   Int?
  kepemilikan KepemilikanAset @default(MilikSendiri)
  kondisi     KondisiAset     @default(Baik)
  status      StatusFasilitas @default(Aktif)
  aksesibel_difabel         Boolean @default(false)
  penggunaan_jam_per_minggu Int?

  tampil_publik Boolean @default(false)
  unggulan      Boolean @default(false)
  urutan        Int     @default(0)

  alat   tbl_fasilitas_alat[]
  berkas tbl_fasilitas_berkas[]

  created_by_id String?       @db.Uuid
  created_by    tbl_profiles? @relation("FasilitasCreatedBy", fields: [created_by_id], references: [id_profile], onDelete: SetNull)
  updated_by_id String?       @db.Uuid
  updated_by    tbl_profiles? @relation("FasilitasUpdatedBy", fields: [updated_by_id], references: [id_profile], onDelete: SetNull)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([kategori_id])
  @@index([gedung_id])
}

// ---------- ALAT (sarana/peralatan per ruang — Tabel Sarana LKPS) ----------
model tbl_fasilitas_alat {
  id_alat      BigInt @id @default(autoincrement())
  fasilitas_id BigInt
  fasilitas    tbl_fasilitas @relation(fields: [fasilitas_id], references: [id_fasilitas], onDelete: Cascade)

  nama            String @db.VarChar(150)
  jumlah_unit     Int    @default(1)
  tahun_perolehan Int?
  kepemilikan     KepemilikanAset @default(MilikSendiri)
  kondisi         KondisiAset     @default(Baik)
  spesifikasi     String?
  tampil_publik   Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([fasilitas_id])
}

// ---------- BERKAS (galeri foto + dokumen pendukung) ----------
model tbl_fasilitas_berkas {
  id_berkas    BigInt @id @default(autoincrement())
  fasilitas_id BigInt
  fasilitas    tbl_fasilitas @relation(fields: [fasilitas_id], references: [id_fasilitas], onDelete: Cascade)

  jenis  JenisBerkasFasilitas
  label  String @db.VarChar(150)
  path   String @db.VarChar(255)
  mime   String? @db.VarChar(100)
  ukuran Int?
  urutan Int    @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([fasilitas_id])
}