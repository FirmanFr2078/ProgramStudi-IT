# connection string pooled, port 6543
# Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler. Kalau nanti muncul
# error prepared statement already exists, tambahin ?pgbouncer=true di akhir URL ini — itu memang fix standarnya buat kombinasi
# Prisma+PgBouncer
DATABASE_URL=

# connection string direct, port 5432
# Dari bagian Direct connection di halaman yang sama. Dipakai khusus prisma migrate/db pull, ga dipakai runtime
DIRECT_URL=

# URL project Supabase
# disiapkan sekarang biar .env.local.example lengkap sekali jadi
NEXT_PUBLIC_SUPABASE_URL=

# service role key
# jangan pernah ke-expose ke client
SUPABASE_SERVICE_ROLE_KEY=

# random string min 32 karakter
# generate pakai openssl rand -base64 32 kalau ada, atau nanti kuaksikan generator-nya
AUTH_SESSION_SECRET=
